@model CoreConcepts.Models.CompanyProject
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Project" : "Add New Project";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h3 class="fw-bold mb-4">@(isEdit ? "Edit Project" : "Add New Project")</h3>

                <form asp-action="@(isEdit ? "EditProject" : "CreateProject")" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @if (isEdit) { <input type="hidden" asp-for="Id" /> }

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Project Title</label>
                        <input asp-for="Title" class="form-control" required placeholder="e.g. Auction Management System" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <input asp-for="Category" class="form-control" placeholder="e.g. Software, Graphics Design, Web App" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Running">Running</option>
                                <option value="Completed">Completed</option>
                                <option value="Upcoming">Upcoming</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Technologies" class="form-label fw-semibold">Technologies / Tools Used</label>
                        <input asp-for="Technologies" class="form-control" placeholder="e.g. .NET 10, MySQL, Bootstrap 5, SignalR" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectUrl" class="form-label fw-semibold">Live Project URL / Demo (Optional)</label>
                        <input asp-for="ProjectUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Project Overview & Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" required placeholder="Explain features, architecture, and objectives..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Project Screenshot / Image (Optional)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mt-2">
                                <small class="text-muted d-block mb-1">Current Image:</small>
                                <img src="@Model.ImagePath" class="rounded border" style="max-height: 80px;" alt="" />
                            </div>
                        }
                    </div>

                    <div class="form-check form-switch fs-5 mb-4">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFeatured" class="form-check-label fs-6 fw-semibold">Feature on Home Page</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save Project</button>
                        <a asp-action="Projects" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
