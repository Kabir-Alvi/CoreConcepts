@model IEnumerable<CoreConcepts.Models.JobOpening>
@{
    ViewData["Title"] = "Job & Internship Openings";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Career & Internship Vacancies</h2>
            <p class="text-muted mb-0">Manage job postings, categories (Software, Graphics, etc.), and view requirements.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateJob" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Post New Vacancy
            </a>
            <a asp-action="Categories" class="btn btn-outline-dark">
                <i class="bi bi-tags me-1"></i> Manage Categories
            </a>
            <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary">Dashboard</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Position Title</th>
                        <th>Department</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Stipend/Salary</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@job.Title</td>
                            <td><span class="badge bg-light text-dark border">@job.JobCategory?.Name</span></td>
                            <td><span class="badge @(job.Type == "Internship" ? "bg-success" : "bg-dark")">@job.Type</span></td>
                            <td><small class="text-muted">@job.Location</small></td>
                            <td><small class="fw-semibold">@(job.SalaryOrStipend ?? "Negotiable")</small></td>
                            <td>
                                @if (job.Deadline.HasValue)
                                {
                                    <small class="text-danger">@job.Deadline.Value.ToString("MMM dd, yyyy")</small>
                                }
                                else
                                {
                                    <small class="text-muted">Open</small>
                                }
                            </td>
                            <td>
                                <span class="badge @(job.IsActive ? "bg-success" : "bg-secondary")">
                                    @(job.IsActive ? "Active" : "Closed")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteJob" asp-route-id="@job.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this job opening?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
