@model IEnumerable<CoreConcepts.Models.CompanyProject>
@{
    ViewData["Title"] = "Projects Management";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Company Projects CMS</h2>
            <p class="text-muted mb-0">Manage running, completed and featured software/design projects.</p>
        </div>
        <div>
            <a asp-action="CreateProject" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add New Project
            </a>
            <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary ms-2">Dashboard</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Project</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Featured</th>
                        <th>Live Link</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proj in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(proj.ImagePath))
                                    {
                                        <img src="@proj.ImagePath" class="rounded shadow-xs" style="width: 50px; height: 35px; object-fit: cover;" alt="" />
                                    }
                                    <div>
                                        <div class="fw-bold">@proj.Title</div>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@proj.Technologies</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@proj.Category</span></td>
                            <td>
                                <span class="badge @(proj.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @proj.Status
                                </span>
                            </td>
                            <td>
                                @if (proj.IsFeatured)
                                {
                                    <span class="badge bg-primary">Featured</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Standard</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(proj.ProjectUrl))
                                {
                                    <a href="@proj.ProjectUrl" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                                        <i class="bi bi-box-arrow-up-right"></i> Link
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditProject" asp-route-id="@proj.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteProject" asp-route-id="@proj.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this project?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
