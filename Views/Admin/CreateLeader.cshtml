@model CoreConcepts.Models.CompanyLeader
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Leader" : "Add Leader / Director";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">@(isEdit ? "Edit Leader Profile" : "Add Board of Director / CEO / MD")</h3>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary btn-sm">Back to About Us</a>
                </div>

                <div class="alert alert-info border-0 shadow-xs mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Seniority / Hierarchy Rule:</strong> Set the rank number according to position hierarchy (e.g., <strong>Rank 1 for CEO</strong>, <strong>Rank 2 for MD</strong>, <strong>Rank 3 for Directors</strong>). Even if a CEO is added after 10 other members, setting Rank 1 will automatically place them at the very top of the page!
                </div>

                <form asp-action="@(isEdit ? "EditLeader" : "CreateLeader")" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @if (isEdit) { <input type="hidden" asp-for="Id" /> }

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="FullName" class="form-label fw-semibold">Leader Full Name</label>
                            <input asp-for="FullName" class="form-control" required placeholder="e.g. Johnathan Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="HierarchyRank" class="form-label fw-semibold text-primary">Seniority Rank (1 = Topmost)</label>
                            <input asp-for="HierarchyRank" type="number" min="1" max="100" class="form-control border-primary fw-bold" required />
                            <small class="text-muted">1: CEO, 2: MD, 3: Exec Director, 4: Director...</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Designation" class="form-label fw-semibold">Official Designation / Title</label>
                        <input asp-for="Designation" class="form-control" required placeholder="e.g. Chief Executive Officer (CEO) or Managing Director (MD)" />
                        <span asp-validation-for="Designation" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Speech" class="form-label fw-semibold">Executive Speech / Statement / Quote</label>
                        <textarea asp-for="Speech" class="form-control" rows="4" required placeholder="Write the leadership message, company vision, or inspirational words..."></textarea>
                        <span asp-validation-for="Speech" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Leader Photo (Headshot)</label>
                        <input type="file" name="photoFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.PhotoPath))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@Model.PhotoPath" class="rounded-circle border" style="width: 50px; height: 50px; object-fit: cover;" alt="Current" />
                                <small class="text-muted">Current photo</small>
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Official Email (Optional)</label>
                            <input asp-for="Email" class="form-control" placeholder="ceo@coreconcepts.com" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LinkedInUrl" class="form-label fw-semibold">LinkedIn Profile URL (Optional)</label>
                            <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." />
                        </div>
                    </div>

                    <div class="form-check form-switch fs-5 mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fs-6 fw-semibold">Show on About Us Page</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Save Profile</button>
                        <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
