@model CoreConcepts.Models.HeroBanner
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Banner" : "Create Hero Banner";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h3 class="fw-bold mb-4">@(isEdit ? "Edit Hero Banner" : "Add New Hero Banner")</h3>

                <form asp-action="@(isEdit ? "EditBanner" : "CreateBanner")" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" required placeholder="e.g. Empowering Digital Evolution with CoreConcepts" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subtitle" class="form-label fw-semibold"></label>
                        <textarea asp-for="Subtitle" class="form-control" rows="2" placeholder="Sub-heading or supporting description..."></textarea>
                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ButtonText" class="form-label fw-semibold">Button Text (Optional)</label>
                            <input asp-for="ButtonText" class="form-control" placeholder="e.g. Explore Careers" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ButtonUrl" class="form-label fw-semibold">Button Link (URL)</label>
                            <input asp-for="ButtonUrl" class="form-control" placeholder="e.g. /Career or /Projects" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Upload Background Image (Optional)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mt-2">
                                <small class="text-muted d-block mb-1">Current Image:</small>
                                <img src="@Model.ImagePath" class="rounded border" style="max-height: 80px;" alt="Current" />
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label fs-6 fw-semibold">Active (Visible)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save Banner</button>
                        <a asp-action="Banners" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
