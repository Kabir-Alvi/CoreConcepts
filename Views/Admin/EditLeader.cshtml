@model CoreConcepts.Models.CompanyLeader
@{
    var isEdit = true;
    ViewData["Title"] = "Edit Leader Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Edit Leader: @Model.FullName</h3>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary btn-sm">Back to About Us</a>
                </div>

                <div class="alert alert-info border-0 shadow-xs mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Seniority / Hierarchy Rule:</strong> Lower rank number appears first (e.g. 1 = CEO, 2 = MD, 3 = Director).
                </div>

                <form asp-action="EditLeader" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="FullName" class="form-label fw-semibold">Leader Full Name</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="HierarchyRank" class="form-label fw-semibold text-primary">Seniority Rank (1 = Topmost)</label>
                            <input asp-for="HierarchyRank" type="number" min="1" max="100" class="form-control border-primary fw-bold" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Designation" class="form-label fw-semibold">Official Designation</label>
                        <input asp-for="Designation" class="form-control" required />
                        <span asp-validation-for="Designation" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Speech" class="form-label fw-semibold">Executive Speech / Statement</label>
                        <textarea asp-for="Speech" class="form-control" rows="4" required></textarea>
                        <span asp-validation-for="Speech" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Change Photo (Optional)</label>
                        <input type="file" name="photoFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.PhotoPath))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@Model.PhotoPath" class="rounded-circle border" style="width: 50px; height: 50px; object-fit: cover;" alt="Current" />
                                <small class="text-muted">Current photo</small>
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Official Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LinkedInUrl" class="form-label fw-semibold">LinkedIn Profile URL</label>
                            <input asp-for="LinkedInUrl" class="form-control" />
                        </div>
                    </div>

                    <div class="form-check form-switch fs-5 mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fs-6 fw-semibold">Show on About Us Page</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Update Profile</button>
                        <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
