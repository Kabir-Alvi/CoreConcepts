@model IEnumerable<CoreConcepts.Models.HeroBanner>
@{
    ViewData["Title"] = "Hero Banners Management";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Hero Banners CMS</h2>
            <p class="text-muted mb-0">Control the dynamic carousel displayed on the home page.</p>
        </div>
        <div>
            <a asp-action="CreateBanner" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add New Banner
            </a>
            <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary ms-2">
                Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Order</th>
                        <th>Preview / Image</th>
                        <th>Title & Subtitle</th>
                        <th>Button</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var banner in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@banner.DisplayOrder</td>
                            <td>
                                @if (!string.IsNullOrEmpty(banner.ImagePath))
                                {
                                    <img src="@banner.ImagePath" class="rounded shadow-xs" style="width: 100px; height: 50px; object-fit: cover;" alt="Banner" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Default Gradient</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@banner.Title</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">@banner.Subtitle</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(banner.ButtonText))
                                {
                                    <span class="badge bg-light text-dark border">@banner.ButtonText (@banner.ButtonUrl)</span>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(banner.IsActive ? "bg-success" : "bg-secondary")">
                                    @(banner.IsActive ? "Active" : "Hidden")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteBanner" asp-route-id="@banner.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this banner?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
