@model CoreConcepts.Models.JobOpening
@{
    ViewData["Title"] = "Edit Vacancy";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h3 class="fw-bold mb-4">Edit Vacancy</h3>

                <form asp-action="EditJob" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="JobCategoryId" class="form-label fw-semibold">Department</label>
                            <select asp-for="JobCategoryId" asp-items="ViewBag.Categories" class="form-select" required></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-semibold">Type</label>
                            <select asp-for="Type" class="form-select">
                                <option value="Internship">Internship</option>
                                <option value="Full-Time">Full-Time</option>
                                <option value="Part-Time">Part-Time</option>
                                <option value="Remote">Remote</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold">Work Location</label>
                            <input asp-for="Location" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalaryOrStipend" class="form-label fw-semibold">Stipend or Salary</label>
                            <input asp-for="SalaryOrStipend" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Deadline" class="form-label fw-semibold">Application Deadline</label>
                        <input asp-for="Deadline" type="date" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Role Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requirements" class="form-label fw-semibold">Requirements</label>
                        <textarea asp-for="Requirements" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-check form-switch fs-5 mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fs-6 fw-semibold">Open for Applications</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Update Vacancy</button>
                        <a asp-action="Jobs" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
