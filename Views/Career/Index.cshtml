@model IEnumerable<CoreConcepts.Models.JobOpening>
@{
    ViewData["Title"] = "Career & Internships at CoreConcepts (CC)";
    var categories = ViewBag.Categories as List<CoreConcepts.Models.JobCategory> ?? new List<CoreConcepts.Models.JobCategory>();
}

<div class="bg-dark text-white py-5 mb-5">
    <div class="container text-center">
        <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Build Your Future With Us</span>
        <h1 class="display-5 fw-bold">Career & Internship Opportunities</h1>
        <p class="lead text-light opacity-75 mx-auto" style="max-width: 650px;">
            Join CoreConcepts to build scalable software, craft engaging visual designs, or embark on a mentorship-driven internship.
        </p>
    </div>
</div>

<div class="container mb-5">

    <!-- Filters & Search -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search job title or keyword..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="0">All Departments / Fields</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(ViewBag.SelectedCategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="All">All Types</option>
                    <option value="Internship" selected="@(ViewBag.SelectedType == "Internship" ? "selected" : null)">Internship</option>
                    <option value="Full-Time" selected="@(ViewBag.SelectedType == "Full-Time" ? "selected" : null)">Full-Time</option>
                    <option value="Part-Time" selected="@(ViewBag.SelectedType == "Part-Time" ? "selected" : null)">Part-Time</option>
                    <option value="Remote" selected="@(ViewBag.SelectedType == "Remote" ? "selected" : null)">Remote</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- Job Listings -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var job in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm feature-card p-4 rounded-3 bg-white">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">@job.JobCategory?.Name</span>
                                    <span class="badge @(job.Type == "Internship" ? "bg-success" : "bg-dark") px-2 py-1">@job.Type</span>
                                    <span class="badge bg-light text-muted border px-2 py-1"><i class="bi bi-geo-alt me-1"></i> @job.Location</span>
                                </div>
                                <h4 class="fw-bold mb-2">@job.Title</h4>
                                <p class="text-muted mb-3" style="max-width: 700px;">
                                    @(job.Description.Length > 160 ? job.Description.Substring(0, 160) + "..." : job.Description)
                                </p>
                                <div class="small text-muted">
                                    @if (!string.IsNullOrEmpty(job.SalaryOrStipend))
                                    {
                                        <span class="me-3"><i class="bi bi-cash-coin me-1 text-success"></i> <strong>Stipend/Salary:</strong> @job.SalaryOrStipend</span>
                                    }
                                    @if (job.Deadline.HasValue)
                                    {
                                        <span><i class="bi bi-calendar-event me-1 text-danger"></i> <strong>Deadline:</strong> @job.Deadline.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                </div>
                            </div>
                            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0 d-flex flex-lg-column gap-2 justify-content-end">
                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary">
                                    View Details
                                </a>
                                <a asp-action="Apply" asp-route-id="@job.Id" class="btn btn-primary shadow-sm">
                                    Apply Now <i class="bi bi-send ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-briefcase display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No vacancies found matching your criteria.</h4>
                <a asp-action="Index" class="btn btn-outline-primary mt-2">View All Openings</a>
            </div>
        }
    </div>

</div>
