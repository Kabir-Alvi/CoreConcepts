@model CoreConcepts.Models.JobOpening
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Career" asp-action="Index">Career</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-primary px-3 py-2 fs-6">@Model.JobCategory?.Name</span>
                <span class="badge bg-dark px-3 py-2 fs-6">@Model.Type</span>
            </div>

            <h1 class="fw-bold mb-3">@Model.Title</h1>
            <p class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location</p>

            <hr class="my-4" />

            <h4 class="fw-bold mb-3">Role Description & Responsibilities</h4>
            <div class="lead fs-6 text-muted mb-4" style="line-height: 1.8; white-space: pre-line;">
                @Model.Description
            </div>

            @if (!string.IsNullOrEmpty(Model.Requirements))
            {
                <h4 class="fw-bold mb-3">Key Requirements & Skills</h4>
                <div class="text-muted mb-4 p-3 bg-light rounded-3" style="line-height: 1.8; white-space: pre-line;">
                    @Model.Requirements
                </div>
            }

            <div class="d-flex gap-3 mt-4">
                <a asp-action="Apply" asp-route-id="@Model.Id" class="btn btn-primary btn-lg shadow-sm px-5">
                    Apply for this Position <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    Back to Listings
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-3 bg-light">
                <h5 class="fw-bold mb-3">Summary</h5>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
                    <li>
                        <small class="text-muted d-block">Department</small>
                        <span class="fw-semibold">@Model.JobCategory?.Name</span>
                    </li>
                    <li>
                        <small class="text-muted d-block">Employment Type</small>
                        <span class="fw-semibold">@Model.Type</span>
                    </li>
                    <li>
                        <small class="text-muted d-block">Location</small>
                        <span class="fw-semibold">@Model.Location</span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.SalaryOrStipend))
                    {
                        <li>
                            <small class="text-muted d-block">Compensation / Stipend</small>
                            <span class="fw-semibold text-success">@Model.SalaryOrStipend</span>
                        </li>
                    }
                    @if (Model.Deadline.HasValue)
                    {
                        <li>
                            <small class="text-muted d-block">Application Deadline</small>
                            <span class="fw-semibold text-danger">@Model.Deadline.Value.ToString("MMMM dd, yyyy")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
