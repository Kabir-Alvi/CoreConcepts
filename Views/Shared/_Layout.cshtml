@inject CoreConcepts.Services.SiteSettingsService SettingsService
@{
    var settings = await SettingsService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.CompanyName (@settings.CompanyShortName)</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Top Notification Bar -->
    <div class="bg-dark text-white py-1 px-3 d-none d-md-block" style="font-size: 0.85rem;">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-geo-alt-fill text-primary me-1"></i> @settings.OfficeAddress &nbsp;|&nbsp; 
                <i class="bi bi-envelope-fill text-primary me-1"></i> @settings.CareerEmail
            </div>
            <div>
                <span class="badge bg-success me-2">We Are Hiring!</span>
                <a asp-controller="Career" asp-action="Index" class="text-white text-decoration-none fw-semibold">
                    Explore Internships & Jobs <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-white" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary text-white p-2 rounded-3 me-2 fs-5">@settings.CompanyShortName</span>
                    <span>@settings.CompanyName</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-code-square me-1"></i> Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Career" asp-action="Index">
                                <i class="bi bi-briefcase me-1"></i> Career & Internships
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>

                    <!-- User / Auth Navigation -->
                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-warning btn-sm" asp-controller="Dashboard" asp-action="Admin">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Panel
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-info btn-sm" asp-controller="Dashboard" asp-action="User">
                                        <i class="bi bi-person-badge me-1"></i> My Applications
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings"><i class="bi bi-sliders me-2"></i>Footer & Site CMS</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Banners"><i class="bi bi-image me-2"></i>Banners</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Projects"><i class="bi bi-folder-check me-2"></i>Projects</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Jobs"><i class="bi bi-briefcase me-2"></i>Job Postings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-person me-2"></i>Resumes & Applications</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="User"><i class="bi bi-file-earmark-text me-2"></i>My Submissions</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm w-100 text-start">
                                                <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alerts -->
    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @(TempData["Success"] ?? TempData["SuccessMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @(TempData["Error"] ?? TempData["ErrorMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Dynamic Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Dynamic Footer Controlled by Admin -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-auto border-top border-secondary position-relative">
        @if (User.IsInRole("Admin"))
        {
            <div class="container mb-3 text-end">
                <a asp-controller="Admin" asp-action="Settings" class="btn btn-warning btn-sm shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Footer & Site Details (Admin)
                </a>
            </div>
        }

        <div class="container">
            <div class="row g-4">
                <!-- Company Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-primary text-white p-2 rounded-3 me-2 fs-5">@settings.CompanyShortName</span>
                        <h4 class="fw-bold mb-0 text-white">@settings.CompanyName</h4>
                    </div>
                    <p class="text-muted" style="line-height: 1.6;">
                        @settings.FooterAboutText
                    </p>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(settings.FacebookUrl))
                        {
                            <a href="@settings.FacebookUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.LinkedInUrl))
                        {
                            <a href="@settings.LinkedInUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-linkedin"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.GitHubUrl))
                        {
                            <a href="@settings.GitHubUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-github"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.TwitterUrl))
                        {
                            <a href="@settings.TwitterUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-twitter-x"></i></a>
                        }
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold text-white mb-3">Company</h5>
                    <ul class="list-unstyled text-muted d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none hover-link">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none hover-link">About CC</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" class="text-muted text-decoration-none hover-link">Our Projects</a></li>
                        <li><a asp-controller="Career" asp-action="Index" class="text-muted text-decoration-none hover-link">Careers & Jobs</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-muted text-decoration-none hover-link">Contact Us</a></li>
                    </ul>
                </div>

                <!-- Career Opportunities -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3">Opportunities</h5>
                    <ul class="list-unstyled text-muted d-flex flex-column gap-2">
                        <li><a asp-controller="Career" asp-action="Index" asp-route-type="Internship" class="text-muted text-decoration-none hover-link">Software Developer Intern</a></li>
                        <li><a asp-controller="Career" asp-action="Index" asp-route-type="Internship" class="text-muted text-decoration-none hover-link">Graphics & UI/UX Intern</a></li>
                        <li><a asp-controller="Career" asp-action="Index" class="text-muted text-decoration-none hover-link">Full-Time Positions</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="text-muted text-decoration-none hover-link">Join Our Talent Pool</a></li>
                    </ul>
                </div>

                <!-- Contact & Headquarters -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3">Headquarters</h5>
                    <ul class="list-unstyled text-muted d-flex flex-column gap-2">
                        <li><i class="bi bi-geo-alt text-primary me-2"></i> @settings.OfficeAddress</li>
                        <li><i class="bi bi-telephone text-primary me-2"></i> @settings.ContactPhone</li>
                        <li><i class="bi bi-envelope text-primary me-2"></i> @settings.ContactEmail</li>
                        <li><i class="bi bi-clock text-primary me-2"></i> @settings.OfficeHours</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start text-muted" style="font-size: 0.9rem;">
                    &copy; @DateTime.UtcNow.Year <span class="fw-bold text-white">@settings.CompanyName (@settings.CompanyShortName)</span>. All rights reserved.
                </div>
                <div class="col-md-6 text-center text-md-end text-muted mt-2 mt-md-0" style="font-size: 0.9rem;">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none me-3">Privacy Policy</a>
                    <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
