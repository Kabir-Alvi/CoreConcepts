@model IEnumerable<CoreConcepts.Models.JobApplication>
@{
    ViewData["Title"] = "Candidate Dashboard";
    var user = ViewBag.User as CoreConcepts.Models.ApplicationUser;
}

<div class="container my-5">
    <div class="p-4 p-md-5 mb-4 bg-white border rounded-4 shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-primary mb-2">Talent Profile</span>
                <h2 class="fw-bold mb-1">Welcome, @(user?.FullName ?? User.Identity?.Name)!</h2>
                <p class="text-muted mb-0">Track all your internship and job applications at CoreConcepts (CC).</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Career" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-briefcase me-1"></i> Browse More Openings
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>My Submitted Applications</h5>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Applied Position</th>
                                <th>Department / Category</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Resume / CV</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@app.JobOpening?.Title</div>
                                        <small class="text-muted"><i class="bi bi-geo-alt"></i> @app.JobOpening?.Location</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@app.JobOpening?.JobCategory?.Name</span>
                                    </td>
                                    <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (app.Status == "Shortlisted")
                                        {
                                            <span class="badge bg-success">Shortlisted</span>
                                        }
                                        else if (app.Status == "Reviewed")
                                        {
                                            <span class="badge bg-info text-dark">Reviewed</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Not Selected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending Review</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@app.CvFilePath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> View CV
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-x display-3 text-muted"></i>
                    <h5 class="mt-3 text-muted">You haven't applied to any positions yet.</h5>
                    <p class="text-muted small">Explore our open software, graphics, and other internships!</p>
                    <a asp-controller="Career" asp-action="Index" class="btn btn-primary btn-sm px-4">Browse Openings</a>
                </div>
            }
        </div>
    </div>
</div>
