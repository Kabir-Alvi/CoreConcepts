@{
    ViewData["Title"] = "About Us - CoreConcepts (CC)";
}

<div class="bg-dark text-white py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">About CoreConcepts (CC)</h1>
        <p class="lead text-light opacity-75 mx-auto" style="max-width: 650px;">
            Pioneering digital enterprise solutions, modern UI/UX design, and practical industry internships.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Our Mission</span>
            <h2 class="fw-bold mb-3">Empowering Innovation Through Code & Creativity</h2>
            <p class="text-muted" style="line-height: 1.8;">
                CoreConcepts (CC) is an engineering and design collective. We engineer robust, enterprise-grade software platforms, sleek digital identities, and high-impact digital experiences. 
            </p>
            <p class="text-muted" style="line-height: 1.8;">
                Beyond production software, CoreConcepts is deeply committed to nurturing the next generation of engineers and designers through our structured internship programs in software development, graphics design, and quality assurance.
            </p>
            <div class="d-flex gap-3 mt-4">
                <a asp-controller="Projects" asp-action="Index" class="btn btn-primary px-4">Our Projects</a>
                <a asp-controller="Career" asp-action="Index" class="btn btn-outline-dark px-4">Join Our Team</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-code-slash display-4 text-primary mb-2"></i>
                        <h3 class="fw-bold mb-1">Software</h3>
                        <p class="text-muted small mb-0">High-performance scalable web and cloud systems</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-palette display-4 text-primary mb-2"></i>
                        <h3 class="fw-bold mb-1">Creative</h3>
                        <p class="text-muted small mb-0">User interfaces, design systems, and visual branding</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-mortarboard display-4 text-success mb-2"></i>
                        <h3 class="fw-bold mb-1">Internships</h3>
                        <p class="text-muted small mb-0">Real client exposure and senior dev mentorship</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-shield-check display-4 text-info mb-2"></i>
                        <h3 class="fw-bold mb-1">Quality</h3>
                        <p class="text-muted small mb-0">Automated testing, stability, and high performance</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
