@model CoreConcepts.Models.SiteSettings
@{
    ViewData["Title"] = "About Us - CoreConcepts (CC)";
}

<div class="bg-dark text-white py-5 mb-5 position-relative">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">About @Model.CompanyName (@Model.CompanyShortName)</h1>
        <p class="lead text-light opacity-75 mx-auto" style="max-width: 650px;">
            Pioneering digital enterprise solutions, modern UI/UX design, and practical industry internships.
        </p>
    </div>
</div>

<div class="container mb-5">
    
    @if (User.IsInRole("Admin"))
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center rounded-3 shadow-xs mb-4">
            <div>
                <i class="bi bi-shield-lock-fill me-2"></i>
                <strong>Admin Mode:</strong> You can edit the mission text and pillars directly.
            </div>
            <a asp-action="EditAbout" class="btn btn-warning btn-sm fw-semibold">
                <i class="bi bi-pencil-square me-1"></i> Edit This Page Content
            </a>
        </div>
    }

    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary px-3 py-2 text-uppercase">Our Mission</span>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="EditAbout" class="btn btn-outline-warning btn-xs py-0 px-2" style="font-size: 0.75rem;" title="Edit Mission">
                        <i class="bi bi-pencil"></i> Edit Mission
                    </a>
                }
            </div>

            <h2 class="fw-bold mb-3">@Model.AboutMissionTitle</h2>
            
            <div class="text-muted" style="line-height: 1.8; white-space: pre-line;">
                @Model.AboutMissionContent
            </div>

            <div class="d-flex gap-3 mt-4">
                <a asp-controller="Projects" asp-action="Index" class="btn btn-primary px-4">Our Projects</a>
                <a asp-controller="Career" asp-action="Index" class="btn btn-outline-dark px-4">Join Our Team</a>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-code-slash display-4 text-primary mb-2"></i>
                        <h4 class="fw-bold mb-1">@Model.Pillar1Title</h4>
                        <p class="text-muted small mb-0">@Model.Pillar1Desc</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-palette display-4 text-primary mb-2"></i>
                        <h4 class="fw-bold mb-1">@Model.Pillar2Title</h4>
                        <p class="text-muted small mb-0">@Model.Pillar2Desc</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-mortarboard display-4 text-success mb-2"></i>
                        <h4 class="fw-bold mb-1">@Model.Pillar3Title</h4>
                        <p class="text-muted small mb-0">@Model.Pillar3Desc</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-light text-center h-100">
                        <i class="bi bi-shield-check display-4 text-info mb-2"></i>
                        <h4 class="fw-bold mb-1">@Model.Pillar4Title</h4>
                        <p class="text-muted small mb-0">@Model.Pillar4Desc</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
