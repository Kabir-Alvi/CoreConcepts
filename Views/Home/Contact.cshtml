@model CoreConcepts.Models.SiteSettings
@{
    ViewData["Title"] = "Contact " + Model.CompanyName;
}

<div class="bg-dark text-white py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Get In Touch</h1>
        <p class="lead text-light opacity-75 mx-auto" style="max-width: 600px;">
            Have a project in mind or want to join our talent network? We'd love to hear from you.
        </p>
    </div>
</div>

<div class="container mb-5">

    @if (User.IsInRole("Admin"))
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center rounded-3 shadow-xs mb-4">
            <div>
                <i class="bi bi-shield-lock-fill me-2"></i>
                <strong>Admin Notice:</strong> The office address, phone, and email shown here are managed via Site Settings.
            </div>
            <a asp-controller="Admin" asp-action="Settings" class="btn btn-warning btn-sm fw-semibold">
                <i class="bi bi-pencil-square me-1"></i> Edit Contact Details
            </a>
        </div>
    }

    <div class="row g-5">
        <div class="col-lg-6">
            <h3 class="fw-bold mb-4">Send Us a Message</h3>
            <form onsubmit="alert('Thank you! Your message has been received.'); return false;">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Your Name</label>
                    <input type="text" class="form-control form-control-lg" required placeholder="John Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Your Email</label>
                    <input type="email" class="form-control form-control-lg" required placeholder="name@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Subject</label>
                    <input type="text" class="form-control form-control-lg" required placeholder="Project inquiry or Career interest" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Message</label>
                    <textarea class="form-control form-control-lg" rows="4" required placeholder="Tell us about your requirements..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Send Message</button>
            </form>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-light position-relative">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">Headquarters & Info</h4>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Settings" class="btn btn-outline-warning btn-xs py-0 px-2" style="font-size: 0.8rem;">
                            <i class="bi bi-pencil"></i> Edit Info
                        </a>
                    }
                </div>
                <div class="d-flex flex-column gap-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="btn btn-primary btn-sm rounded-circle p-2"><i class="bi bi-geo-alt fs-5"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Office Location</h6>
                            <p class="text-muted mb-0">@Model.OfficeAddress</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="btn btn-primary btn-sm rounded-circle p-2"><i class="bi bi-envelope fs-5"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Email Addresses</h6>
                            <p class="text-muted mb-0">General: @Model.ContactEmail</p>
                            <p class="text-muted mb-0">Careers: @Model.CareerEmail</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="btn btn-primary btn-sm rounded-circle p-2"><i class="bi bi-telephone fs-5"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Phone & Hours</h6>
                            <p class="text-muted mb-0">@Model.ContactPhone</p>
                            <small class="text-muted">(@Model.OfficeHours)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
